title('a) \theta advection')
hold on
%[a1T,a2T] = meshgrid(T_gradient_grid,wspd_grid_adj);
%subplot(3,1,1)
contourf(a1T_hr,a2T_hr,advT_hr,[min_color_adv_T:step_color_adv_T:max_color_adv_T],'LineColor','none')
%hold on; plot(typical_q_grad_adj,typical_wspd_adj, 'ko', 'LineWidth',5); hold on
%hold on; plot(extreme_q_grad_adj,extreme_wspd_adj, 'ks', 'LineWidth',5); hold on
